# Optional AbuseIPDB v2 checks (one request per IP, cached for six hours).
ABUSEIPDB_API_KEY=

# Optional exact-URL PhishTank lookups. URLs are sent only when this key is set.
# At most one URL per message is checked by default (maximum configurable value is three).
PHISHTANK_API_KEY=
PHISHTANK_MAX_URL_CHECKS=1

# Optional local labeled dataset CSV: columns must be text,label; labels are
# legitimate, suspicious, impersonated, phishing, or fraud. Restart after changes.
EMAIL_ML_TRAINING_CSV=

# Optional operator-maintained IPv4/IPv6 lists. Separate values with commas or spaces.
# Use reputable, regularly updated sources before configuring these lists.
BOTNET_C2_IPS=
OPEN_RELAY_IPS=

# Optional expansion of known shorteners only; limited public-DNS checks and redirects.
ENABLE_SAFE_SHORTENER_RESOLUTION=false

# Preserve submitted message bytes in the evidence artifact table; deletion purges the artifact but retains its hash log.
PRESERVE_RAW_EVIDENCE=true
EVIDENCE_MAX_ARTIFACT_MB=10

# Privacy defaults (0 disables automatic investigation expiry).
INVESTIGATION_RETENTION_DAYS=0
MASK_EMAIL_ADDRESSES=false
MASK_IP_ADDRESSES=false

# Supplemental traditional TCP WHOIS (RDAP remains the primary registration source).
WHOIS_LOOKUP_ENABLED=true
